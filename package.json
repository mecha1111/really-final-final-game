{
  "name": "really-final-final-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "bash -c 'vite build && find dist -name .DS_Store -delete' _",
    "preview": "vite preview",
    "serve": "node tools/serve.mjs dist 8877",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.mecha1111.reallyfinalfinalgame",
    "productName": "진짜_최종_final_수정_진짜최종(5)",
    "artifactName": "${productName}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    }
  }
}
